# Public site URL (used for canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://theambitionroom.com

# Email via Resend (required — applications are delivered by email)
RESEND_API_KEY=
# Must be a verified sender in Resend (cannot use Gmail as the "from" address)
RESEND_FROM_EMAIL=The Ambition Room <onboarding@resend.dev>

# Where applications are delivered (defaults to theambitionroomhfx@gmail.com)
APPLICATIONS_NOTIFY_EMAIL=theambitionroomhfx@gmail.com

# Optional social / contact
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_CONTACT_EMAIL=theambitionroomhfx@gmail.com
